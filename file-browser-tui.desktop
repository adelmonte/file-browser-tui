[Desktop Entry]
Type=Application
Name=File Browser TUI
GenericName=File Manager
Comment=A Dolphin-like file manager for kitty
Exec=file-browser-tui --kitty %f
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
Keywords=files;folders;browser;explorer;
StartupWMClass=file-browser-tui
